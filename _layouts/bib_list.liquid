---
---
<article id="{{ entry.key }}" class="publication-entry">
  <p class="publication-authors">
    {%- for author in entry.author_array -%}
      {%- unless forloop.first -%}, {% endunless -%}
      {%- assign given_names = author.first | replace: '-', ' ' | split: ' ' -%}
      {%- capture author_name -%}
        {{- author.last }} {% for name in given_names %}{{ name | slice: 0, 1 | upcase }}{% endfor %}
      {%- endcapture -%}
      {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
        <strong>{{ author_name }}</strong>
      {%- else -%}
        {{- author_name -}}
      {%- endif -%}
      {%- if forloop.last -%}.{%- endif -%}
    {%- endfor -%}
  </p>
  <p class="publication-citation">
    <span class="publication-title">{{ entry.title }}.</span>
    <em>{{ entry.journal }}</em> {{ entry.year -}}
    {%- if entry.volume %}; {{ entry.volume }}{% endif -%}
    {%- if entry.number %}({{ entry.number }}){% endif -%}
    {%- if entry.pages %}: {{ entry.pages }}{% endif %}.
  </p>
  <p class="publication-links">
    {% if entry.doi %}
      <a href="https://doi.org/{{ entry.doi }}">
        {%- if entry.journal == 'bioRxiv' %}Preprint{% else %}Article{% endif -%}
      </a>
    {% endif %}
    {% if entry.preprint %}
      <a href="{{ entry.preprint }}">Preprint</a>
    {% endif %}
    {% if entry.fulltext %}
      {% assign pdf_url = entry.fulltext %}
      {% unless pdf_url contains '://' %}
        {% assign pdf_url = pdf_url | prepend: '/assets/pdf/' | relative_url %}
      {% endunless %}
      <a href="{{ pdf_url }}">PDF</a>
    {% endif %}
    {% if entry.data %}
      <a href="{{ entry.data }}">Data</a>
    {% endif %}
    {% if entry.video and site.enable_video_embedding %}
      <a href="#video-{{ entry.key }}" role="button" data-toggle="collapse" aria-expanded="false" aria-controls="video-{{ entry.key }}">Video</a>
    {% elsif entry.video %}
      <a href="{{ entry.video }}">Video</a>
    {% endif %}
  </p>
  {% if entry.video and site.enable_video_embedding %}
    <div class="collapse" id="video-{{ entry.key }}">
      {%
        include video.liquid
        path=entry.video
        class="img-fluid rounded z-depth-1"
        title=entry.video_title
        controls=true
        style="width: 100%; height: 100%; aspect-ratio: 16 / 9; max-width: 100%; overflow: hidden; border: none"
        allow="fullscreen; accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
        scrolling="auto"
      %}
    </div>
  {% endif %}
</article>
